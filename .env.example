# Copia este archivo como .env y coloca tus valores reales.
# .env NUNCA debe subirse al repositorio ni ir dentro de un .zip.
# En Render estas mismas variables van en: Dashboard > tu servicio > Environment.

# =========================================================
# APLICACIÓN
# =========================================================
# local = tu computador | production = Render
APP_ENV=local
APP_DEBUG=true
# URL pública del sitio, SIN barra al final. Obligatoria en producción
# (se usa para el enlace del correo de recuperar contraseña).
# Ej: https://biglobal.onrender.com
APP_URL=

# =========================================================
# BASE DE DATOS
# =========================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biglobal
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# TiDB Cloud exige SSL: en Render pon DB_SSL=true (y DB_PORT=4000)
DB_SSL=false
# Ruta del certificado. En Docker ya viene en esta ruta; no la cambies.
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# =========================================================
# GOOGLE OAUTH
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/BiGlobal/src/auth/google_callback.php

# =========================================================
# CORREO — recuperar contraseña y avisos al equipo
# En Render gratis el SMTP está bloqueado (puertos 25/465/587):
# usa la API de Brevo. Si BREVO_API_KEY tiene valor, se usa Brevo.
# El remitente debe estar verificado en Brevo (Senders).
# =========================================================
BREVO_API_KEY=
CORREO_REMITENTE=

# =========================================================
# CORREO (SMTP) — alternativa para tu computador o un plan pago
# Si se dejan vacías se usan las de Configuración > Correo del panel admin.
# Recomendado: ponerlas aquí para que la clave no quede guardada en la BD.
# =========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls (puerto 587) | ssl (puerto 465) | none
SMTP_ENCRYPTION=tls
SMTP_FROM=
